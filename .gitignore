misses.txt
orphans*.txt
suspects*.txt
1.txt

# ZCode 工具本地忽略配置（本地工具产物，不入库）
.zcodeignore
.zcode/

# 本地游戏资源（SD 模型/立绘，体积过大，按需本地放置，不入版本控制）
resource/

