<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 路径声明：
     1) cache/watermark_camera  —— 系统相机通过授予的 content Uri 写入拍摄结果；
     2) cache/diagnostics       —— 设置页「导出诊断包」分享 zip；
     3) cache/voice_cards       —— 台词卡分享（PNG，1080×1440）；
     4) cache/voice_cards_html  —— 台词语音卡分享（单文件 HTML，头像内嵌、语音走原站链接）；
     5) cache/share_audio       —— 「卡片 + 语音文件」通道的临时 mp3（文件名含 URL 摘要，
                                  中配/日配不会互相覆盖）。
     ⚠️ 这五条必须与合成器里的 DIR 常量一致，否则 FileProvider.getUriForFile 抛
     IllegalArgumentException，表现为「分享失败：文件不在允许的目录」。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="watermark_camera"
        path="watermark_camera/" />
    <cache-path
        name="diagnostics"
        path="diagnostics/" />
    <cache-path
        name="voice_cards"
        path="voice_cards/" />
    <cache-path
        name="voice_cards_html"
        path="voice_cards_html/" />
    <cache-path
        name="share_audio"
        path="share_audio/" />
</paths>
