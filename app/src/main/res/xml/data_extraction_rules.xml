<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+（API 31+）的数据提取规则。

    安全策略：云备份与设备间迁移均排除 DataStore 文件
    （player_settings.preferences_pb）。该文件包含 AI API Key、
    啾信聊天会话与历史消息等敏感数据，不应随备份外发。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/player_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/player_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
