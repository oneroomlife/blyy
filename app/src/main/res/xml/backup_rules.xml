<?xml version="1.0" encoding="utf-8"?>
<!--
    旧设备（API < 31）的自动备份规则。

    安全策略：排除 DataStore 文件（player_settings.preferences_pb）。
    该文件包含 AI API Key、啾信聊天会话与历史消息等敏感数据，
    云备份/设备迁移不应携带明文密钥与私密对话。
-->
<full-backup-content>
    <exclude domain="file" path="datastore/player_settings.preferences_pb" />
</full-backup-content>
