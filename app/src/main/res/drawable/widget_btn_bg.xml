<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件胶囊按钮底：垂直渐变 + 亮描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#22507B"
        android:centerColor="#1B3F63"
        android:endColor="#16324F"
        android:type="linear" />
    <corners android:radius="17dp" />
    <stroke
        android:width="1dp"
        android:color="#3E7BA8" />
</shape>
