<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- Android 13+ 必须 -->
    <!-- Android 14+ 前台服务类型声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- SD 小人外部资源加载：用户通过 SAF 选择源目录，整理到应用专属外部存储 -->
    <!-- Android 12 及以下：READ_EXTERNAL_STORAGE 访问公共 Download 目录（兼容旧版用户） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+ 不再请求 MANAGE_EXTERNAL_STORAGE，改用 SAF + 应用专属目录（免权限） -->

    <!-- 水印相机：改用系统相机（ACTION_IMAGE_CAPTURE + FileProvider），无需 CAMERA 权限；
         声明了但未授予的 CAMERA 权限反而在部分设备上导致系统相机拒拍。
         相机为可选功能（无相机设备仍可从图库选图） -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- 水印相机：仅 Android 9 及以下写公共 Pictures 目录需要（Android 10+ 经 MediaStore 免权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- 支持手表等小屏设备 -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:resizeable="true"
        android:anyDensity="true" />

    <application
        android:name="com.azurlane.blyy.MyApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/cf"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/cfr"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blyy"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <activity
            android:name="com.azurlane.blyy.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Blyy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>

        <!-- 水印相机：系统相机拍照输出到 cache 临时文件的 content Uri 提供者 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 注册悬浮窗服务 -->
        <service
            android:name=".SecretaryOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ Play Store 审核要求：声明 specialUse 子类型用途 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="companion_overlay" />
        </service>

    </application>

</manifest>
